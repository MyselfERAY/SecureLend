# --- apps/bi (BI Editor) ---

# Secret used to sign session JWTs (jose). 32+ random chars. ZORUNLU (production).
# Üret: openssl rand -base64 48
BI_AUTH_SECRET=

# 32-byte key (hex = 64 chars) used to AES-256-GCM encrypt stored Oracle
# connection passwords at rest. ZORUNLU (production, tam 64 hex karakter).
# Üret: openssl rand -hex 32
BI_CRYPTO_KEY=

# Where the JSON metadata store (users, connections, reports, shares) is kept.
# Defaults to apps/bi/data
BI_DATA_DIR=

# Seed/bootstrap admin (ilk boot'ta, kullanıcı yoksa oluşturulur).
# Production'da PAROLAYI MUTLAKA AYARLAYIN; boş bırakılırsa rastgele üretilip
# sunucu loglarına bir kez yazılır (varsayılan "admin1234" production'da kullanılmaz).
BI_BOOTSTRAP_ADMIN_USER=admin
BI_BOOTSTRAP_ADMIN_PASSWORD=

# Optional safety cap on rows scanned/returned per query page.
BI_MAX_PAGE_SIZE=500
